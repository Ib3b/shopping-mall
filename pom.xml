<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>io.github.ib3b</groupId>
    <artifactId>shopping-mall-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Claude示例开发工程</name>
    <description>Spring Boot 多模块示例工程</description>
    <url>https://github.com/Ib3b/shopping-mall</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Ib3b</id>
            <name>Ib3b</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Ib3b/shopping-mall.git</connection>
        <developerConnection>scm:git:ssh://github.com/Ib3b/shopping-mall.git</developerConnection>
        <url>https://github.com/Ib3b/shopping-mall</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.3.0</springdoc.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <gatling.version>3.13.5</gatling.version>
        <gatling-maven-plugin.version>4.21.0</gatling-maven-plugin.version>
        <scala.version>2.13.16</scala.version>
    </properties>

    <modules>
        <module>mystarter</module>
        <module>shopping-mall-app</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Ib3b/shopping-mall</url>
        </repository>
    </distributionManagement>
</project>